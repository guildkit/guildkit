{
  "extends": "@phanect/configs/ts",
  "compilerOptions": {
    "types": [
      "node",
      "vinext/types"
    ],

    "tsBuildInfoFile": "./.tsbuildinfo",

    // Required to use `references`
    "composite": true,
    "declaration": true,
    "noEmit": null,
    "emitDeclarationOnly": true,

    // Better typings for openapi-typescript
    "noUncheckedIndexedAccess": true,

    "paths": {
      "@/*": [ "./src/*" ]
    }
  },
  "references": [
    { "path": "../db" },
    { "path": "../shared" }
  ],
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.js",
    "./**/*.jsx",
    // Route types generated by Vinext (e.g. `RouteContext`)
    "./.next/types/**/*.ts",
    // Imported by src/lib/config.ts
    "../../guildkit.config.ts"
  ],
  "exclude": [
    "./**/node_modules/**",
    "./**/dist/**"
  ]
}
