{
  "name": "@guildkit/client",
  "version": "0.0.1-prealpha",
  "description": "GuildKit's typed API client for the backend",
  "author": {
    "name": "tenkumo, Inc.",
    "url": "https://tenkumogroup.com"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "*",
    "!*.log",
    "!*.tgz",
    "!.gitignore",
    "!tsdown.config.ts"
  ],
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "pnpm run sync && NODE_ENV=production tsdown",
    "lint": "pnpm run sync && tsc --noEmit",
    "sync": "openapi-typescript ../backend/openapi/openapi.json --output ./src/generated/openapi.ts && tsdown"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@guildkit/backend": "workspace:*",
    "@phanect/configs": "2026.5.19",
    "@types/node": "^24.12.4",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.21",
    "tsdown": "0.22.2",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
