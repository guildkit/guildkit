{
  "name": "guildkit-monorepo",
  "author": {
    "name": "tenkumo, Inc.",
    "url": "https://tenkumogroup.com"
  },
  "contributors": [
    {
      "name": "Jumpei Ogawa",
      "url": "https://phanective.org"
    }
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run -r --if-present --stream --parallel dev",
    "build": "pnpm run -r --if-present --stream build",
    "test": "pnpm run -r --if-present --stream test",
    "lint": "pnpm run -r --if-present --stream lint && tsc --noEmit && eslint",
    "fix": "pnpm run -r --if-present --stream fix && eslint --fix",
    "db": "psql --username=guildkit --dbname=guildkit --host=localhost --port=5432",
    "ai-postedit": "pnpm run -r --if-present --stream lint && tsc --noEmit && eslint --fix && pnpm run -r --if-present --stream fix",
    "sync": "pnpm run -r --if-present sync",
    "prepare": "nu scripts/prepare.nu && pnpm run sync",
    "refresh": "nu scripts/refresh.nu",
    "clean": "podman compose down --rmi local --volumes --remove-orphans; git clean -dX --exclude=\"!.env\" --exclude=\"!mise.local.toml\" --force"
  },
  "devDependencies": {
    "@phanect/configs": "2026.8.29",
    "@phanect/lint": "latest",
    "@phanect/lint-react": "latest",
    "@types/node": "^24.10.0",
    "dotenv": "^18.0.0",
    "eslint": "^10.0.0",
    "neonctl": "^8.0.0",
    "nushell": "^0.116.0",
    "skills": "^1.7.0",
    "typescript": "^6.0.0",
    "vercel": "^63.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
